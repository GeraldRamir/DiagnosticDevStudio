# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# Copia este archivo a `.env` y completa los valores reales ahí.
# NUNCA pongas secretos en este archivo: se versiona en git.
# ─────────────────────────────────────────────────────────────

# Neon PostgreSQL — pooled (app) y directo (migraciones Prisma CLI)
# Neon Console → Connection Details: la URL con `-pooler` va en DATABASE_URL,
# la URL sin pooler va en DIRECT_URL.
DATABASE_URL=
DIRECT_URL=

# Google Gemini (capa gratuita) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_NARRATIVE_ENABLED=true

# Google PageSpeed Insights — API key de Google Cloud (NO la URL del endpoint)
PAGESPEED_API_KEY=

# Resend (correos) — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=

# Admin — contraseña del panel /admin
ADMIN_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CAL_LINK=

# Instagram Graph API (Instagram Login). Solo servidor.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=devstudio_ig_wh_2026
INSTAGRAM_SITE_URL=https://devstuddio.netlify.app
INSTAGRAM_APP_ID=
INSTAGRAM_ADMIN_KEY=
# Solo si más adelante usas Facebook Login + Business Discovery:
INSTAGRAM_GRAPH_HOST=https://graph.instagram.com
INSTAGRAM_USER_ID=
